---
import Base from '../layouts/Base.astro';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { GaugeIcon, ShieldCheckIcon, UsersIcon, SearchIcon, BadgeIcon, EyeIcon } from '../components/site/Icons';

const WHY_POINTS = [
  {
    icon: GaugeIcon,
    title: 'Precision Service',
    body: 'Every job is measured, torqued and tested to spec. We work to the numbers, not to guesswork.',
  },
  {
    icon: UsersIcon,
    title: 'Experienced Technicians',
    body: 'A team trained across European and performance marques, with the hands-on depth that complex repairs demand.',
  },
  {
    icon: SearchIcon,
    title: 'Advanced Diagnostics',
    body: 'Computerised fault scanning pinpoints the real issue first, so you only pay for the work that matters.',
  },
  {
    icon: BadgeIcon,
    title: 'Genuine-Quality Parts',
    body: 'OEM and OEM-grade components only. The right part, fitted right, backed by our workmanship.',
  },
  {
    icon: EyeIcon,
    title: 'Transparent Service',
    body: 'Clear estimates, honest timelines and no surprise line items. You approve before we proceed.',
  },
  {
    icon: ShieldCheckIcon,
    title: 'Workmanship You Trust',
    body: 'Quality-checked at every handover and standing behind every repair that leaves the bay.',
  },
];
---

<Base 
  title="About Grand Motors | Best Car Mechanic & Auto Service Center Hyderabad" 
  description="Discover Grand Motors, Hyderabad’s premier auto repair shop and certified car mechanic workshop in Moosapet. Precision engineering, honest pricing, and genuine OEM parts."
  keywords="about Grand Motors, best car mechanic near me in Hyderabad, auto mechanic Hyderabad, car maintenance Hyderabad, auto repair shop Moosapet"
>
  <main class="pt-32 sm:pt-36 md:pt-40 pb-16 md:pb-24">
    <section class="px-4 sm:px-8 md:px-12 lg:px-16">
      <div class="max-w-7xl mx-auto grid gap-10 lg:gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading
            eyebrow="About Us"
          >
            <Fragment slot="title">A Premium Workshop<br class="hidden sm:block" /> In The Heart Of Hyderabad</Fragment>
          </SectionHeading>
          
          <Reveal as="p" delay={120} class="mt-5 sm:mt-6 text-xs sm:text-sm md:text-[15px] leading-relaxed text-[var(--gm-text-secondary)]">
            Grand Motors is a premium automotive workshop in Moosapet, Hyderabad, built for drivers
            who refuse to compromise on how their car is cared for. We pair modern diagnostic
            equipment with genuinely experienced technicians to deliver service that is precise,
            transparent and dependable.
          </Reveal>
          <Reveal as="p" delay={200} class="mt-3 sm:mt-4 text-xs sm:text-sm md:text-[15px] leading-relaxed text-[var(--gm-text-secondary)]">
            From routine maintenance to complex repairs and full detailing, every vehicle is treated
            with the same standard of craftsmanship. No shortcuts, no surprises — just the quality
            your car deserves.
          </Reveal>

          <Reveal delay={280} class="mt-8 sm:mt-10 grid grid-cols-3 gap-3 sm:gap-6 max-w-md">
            {[
              { k: '8+', v: 'Service Categories' },
              { k: '100%', v: 'Quality-Checked' },
              { k: 'Genuine', v: 'Grade Parts' },
            ].map((stat) => (
              <div>
                <div class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-[-0.02em] text-[var(--gm-accent-primary)]">
                  {stat.k}
                </div>
                <div class="mt-1 text-[10px] sm:text-[11px] tracking-[0.12em] sm:tracking-[0.14em] uppercase text-[var(--gm-text-secondary)]/80 leading-tight">
                  {stat.v}
                </div>
              </div>
            ))}
          </Reveal>
        </div>

        <Reveal delay={120} class="relative">
          <div class="relative rounded-2xl border border-[var(--gm-border-subtle)] bg-[var(--gm-bg-card)] p-6 sm:p-8 md:p-10 overflow-hidden shadow-lg">
            <div
              aria-hidden="true"
              class="absolute -top-20 -right-20 w-56 h-56 rounded-full bg-[var(--gm-accent-primary)]/10 blur-3xl"
            ></div>
            <div class="relative">
              <GaugeIcon className="w-8 h-8 sm:w-9 sm:h-9 text-[var(--gm-accent-primary)]" />
              <blockquote class="mt-5 sm:mt-6 text-lg sm:text-xl md:text-2xl font-semibold leading-snug tracking-[-0.015em] text-[var(--gm-text-primary)]">
                “We treat every car as if the next drive depends on it — because it does.”
              </blockquote>
              <div class="mt-5 sm:mt-6 flex items-center gap-3">
                <span class="w-6 sm:w-8 h-px bg-[var(--gm-accent-primary)]"></span>
                <span class="text-[11px] sm:text-[12px] tracking-[0.16em] sm:tracking-[0.18em] uppercase text-[var(--gm-text-secondary)]">
                  The Grand Motors Standard
                </span>
              </div>
            </div>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- WHY GRAND MOTORS -->
    <section class="mt-20 md:mt-24 px-4 sm:px-8 md:px-12 lg:px-16 py-16 md:py-28 bg-[var(--gm-bg-surface)] border-y border-[var(--gm-border-subtle)] transition-colors duration-200">
      <div class="max-w-7xl mx-auto">
        <SectionHeading
          eyebrow="Why Grand Motors"
          intro="A premium workshop is defined by its standards. These are ours — the reasons drivers in Hyderabad bring their cars to us and keep coming back."
        >
          <Fragment slot="title">Built On Precision,<br class="hidden sm:block" /> Backed By Trust</Fragment>
        </SectionHeading>

        <div class="mt-10 sm:mt-14 grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
          {WHY_POINTS.map((point, i) => {
            const Icon = point.icon;
            return (
              <Reveal
                delay={(i % 3) * 70}
                class="group relative rounded-xl border border-[var(--gm-border-subtle)] bg-[var(--gm-bg-card)] p-6 sm:p-7 transition-all duration-200 hover:border-[var(--gm-accent-border)] hover:bg-[var(--gm-bg-card-hover)] shadow-sm"
              >
                <span class="grid place-items-center w-10 h-10 sm:w-11 sm:h-11 rounded-lg border border-[var(--gm-accent-border)] bg-[var(--gm-accent-muted)] text-[var(--gm-accent-primary)] shadow-sm">
                  <Icon className="w-5 h-5" />
                </span>
                <h3 class="mt-4 sm:mt-5 text-base font-semibold text-[var(--gm-text-primary)]">{point.title}</h3>
                <p class="mt-2 text-xs sm:text-[13.5px] leading-relaxed text-[var(--gm-text-secondary)]">{point.body}</p>
              </Reveal>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 1. WORKSHOP APPROACH -->
    <section class="px-4 sm:px-8 md:px-12 lg:px-16 py-16 md:py-28 relative overflow-hidden bg-[var(--gm-bg-page)] transition-colors duration-200">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--gm-accent-primary)]/30 to-transparent"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <Reveal>
          <div class="text-[10px] sm:text-[11px] tracking-[0.2em] uppercase text-[var(--gm-accent-primary)] text-center mb-4 sm:mb-6">Workshop Approach</div>
          <h2 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-[-0.03em] text-[var(--gm-text-primary)] text-center uppercase">
            Built Around <span class="text-[var(--gm-accent-primary)]">Your Drive</span>
          </h2>
        </Reveal>

        <div class="mt-12 sm:mt-16 md:mt-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          {[
            { num: '01', title: 'INSPECT', desc: 'Thorough multi-point visual and technical evaluation to determine baseline vehicle condition.' },
            { num: '02', title: 'DIAGNOSE', desc: 'Advanced computer scanning and testing to pinpoint the exact root cause of any issue.' },
            { num: '03', title: 'REPAIR', desc: 'Precision execution by skilled technicians using specialized tools and OEM-grade parts.' },
            { num: '04', title: 'DELIVER', desc: 'Final quality control, road testing, and pristine handover back to the driver.' }
          ].map((step, i) => (
            <Reveal delay={i * 100} class="relative group">
              {i !== 3 && (
                <div class="hidden lg:block absolute top-[44px] left-[70%] w-full h-[1px] bg-gradient-to-r from-[var(--gm-accent-primary)]/20 to-transparent"></div>
              )}

              <div class="text-5xl sm:text-6xl md:text-[72px] font-bold text-[var(--gm-border-strong)] group-hover:text-[var(--gm-accent-primary)]/25 transition-colors duration-500 leading-none select-none">
                {step.num}
              </div>
              <div class="mt-4 sm:mt-6 border-l-2 border-[var(--gm-accent-border)] pl-4 sm:pl-5 group-hover:border-[var(--gm-accent-primary)] transition-colors duration-300">
                <h3 class="text-base sm:text-lg md:text-xl font-bold text-[var(--gm-text-primary)] tracking-widest">{step.title}</h3>
                <p class="mt-2 sm:mt-3 text-xs sm:text-[13px] md:text-sm text-[var(--gm-text-secondary)] leading-relaxed max-w-[250px]">
                  {step.desc}
                </p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- 2. GRAND MOTOR STANDARD -->
    <section class="px-4 sm:px-8 md:px-12 lg:px-16 py-16 md:py-28 bg-[var(--gm-bg-surface)] border-y border-[var(--gm-border-subtle)] relative overflow-hidden transition-colors duration-200">
      <!-- subtle background radial glow -->
      <div class="absolute top-1/2 left-0 -translate-y-1/2 w-96 h-96 bg-[var(--gm-accent-primary)]/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10 flex flex-col lg:flex-row gap-10 sm:gap-14 lg:gap-24">
        <div class="lg:w-1/3">
          <Reveal>
            <div class="text-[10px] sm:text-[11px] tracking-[0.2em] uppercase text-[var(--gm-accent-primary)] mb-4 sm:mb-6">The Grand Motor Standard</div>
            <h2 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-[-0.03em] text-[var(--gm-text-primary)] uppercase leading-[1.1]">
              No Compromise.<br/>
              Just Precision.
            </h2>
          </Reveal>
        </div>

        <div class="lg:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-x-8 sm:gap-x-12 gap-y-8 sm:gap-y-12">
          <Reveal delay={0}>
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-[var(--gm-text-primary)] flex items-baseline gap-3 sm:gap-4">
              <span class="text-[var(--gm-accent-primary)] text-xl sm:text-2xl hidden sm:inline-block">/</span>
              Precision-focused service
            </h3>
            <p class="mt-3 sm:mt-4 text-xs sm:text-[14px] md:text-[15px] text-[var(--gm-text-secondary)] leading-relaxed">
              Every job is measured, torqued and tested to exact specifications. We work to the numbers, ensuring flawless operation before keys are handed back.
            </p>
          </Reveal>

          <Reveal delay={100}>
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-[var(--gm-text-primary)] flex items-baseline gap-3 sm:gap-4">
              <span class="text-[var(--gm-accent-primary)] text-xl sm:text-2xl hidden sm:inline-block">/</span>
              Advanced diagnostics
            </h3>
            <p class="mt-3 sm:mt-4 text-xs sm:text-[14px] md:text-[15px] text-[var(--gm-text-secondary)] leading-relaxed">
              Computerised fault scanning and telemetry pinpoint the issue first. Accurate problem solving eliminates guesswork and unnecessary costs.
            </p>
          </Reveal>

          <Reveal delay={200}>
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-[var(--gm-text-primary)] flex items-baseline gap-3 sm:gap-4">
              <span class="text-[var(--gm-accent-primary)] text-xl sm:text-2xl hidden sm:inline-block">/</span>
              Genuine-quality parts
            </h3>
            <p class="mt-3 sm:mt-4 text-xs sm:text-[14px] md:text-[15px] text-[var(--gm-text-secondary)] leading-relaxed">
              We exclusively use OEM and OEM-grade components. The right part, correctly fitted, provides longevity and preserves your vehicle's integrity.
            </p>
          </Reveal>

          <Reveal delay={300}>
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-[var(--gm-text-primary)] flex items-baseline gap-3 sm:gap-4">
              <span class="text-[var(--gm-accent-primary)] text-xl sm:text-2xl hidden sm:inline-block">/</span>
              Transparent service
            </h3>
            <p class="mt-3 sm:mt-4 text-xs sm:text-[14px] md:text-[15px] text-[var(--gm-text-secondary)] leading-relaxed">
              Clear estimates, honest timelines, and straightforward communication. You maintain full oversight and approve all work before we proceed.
            </p>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- 3. FINAL CTA -->
    <section class="px-4 sm:px-8 md:px-12 lg:px-16 py-20 sm:py-28 md:py-36 relative flex items-center justify-center text-center bg-[var(--gm-bg-page)] transition-colors duration-200">
      <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
        <Reveal>
          <h2 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-[-0.04em] text-[var(--gm-text-primary)] uppercase">
            Your Car <br class="sm:hidden" />Deserves Better.
          </h2>
          <p class="mt-4 sm:mt-6 text-sm sm:text-lg md:text-xl text-[var(--gm-text-secondary)] max-w-2xl mx-auto">
            Precision service. Transparent work. Built for the road ahead.
          </p>
        </Reveal>

        <Reveal delay={200} class="mt-8 sm:mt-12 flex flex-col sm:flex-row items-center gap-3 sm:gap-4 justify-center w-full max-w-md mx-auto sm:max-w-none">
          <a
            href="/book-service"
            class="group relative inline-flex items-center justify-center gap-3 w-full sm:w-auto px-7 sm:px-8 py-3.5 sm:py-4 bg-[var(--gm-accent-primary)] text-[var(--gm-accent-foreground)] font-bold text-xs sm:text-[13px] tracking-[0.16em] uppercase rounded-full overflow-hidden transition-all hover:bg-[var(--gm-accent-hover)] text-center shadow-lg shadow-[var(--gm-accent-primary)]/20"
          >
            <span>Book A Service</span>
          </a>

          <a
            href="/contact"
            class="group inline-flex items-center justify-center gap-3 w-full sm:w-auto px-7 sm:px-8 py-3.5 sm:py-4 bg-transparent text-[var(--gm-text-primary)] font-bold text-xs sm:text-[13px] tracking-[0.16em] uppercase border border-[var(--gm-border-medium)] rounded-full transition-all hover:border-[var(--gm-accent-border)] hover:bg-[var(--gm-accent-muted)] text-center shadow-sm"
          >
            <span>Contact Workshop</span>
          </a>
        </Reveal>
      </div>
    </section>
  </main>
</Base>
