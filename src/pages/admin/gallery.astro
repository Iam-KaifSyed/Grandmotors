---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { GalleryManager } from '../../components/admin/GalleryManager';
import { isValidAdminSession } from '../../lib/serverAuth';

let authed = false;
try {
  const admin = await Astro.session?.get('admin');
  const adminSince = await Astro.session?.get('adminSince');
  authed = isValidAdminSession({ admin, adminSince });
} catch {
  authed = false;
}
if (!authed) {
  return Astro.redirect('/admin/login', 302);
}
---

<AdminLayout title="Gallery Manager | Grand Motors Admin">
  <GalleryManager client:load />
</AdminLayout>
