---
import Base from '../layouts/Base.astro';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { MyBookingsFlow } from '../components/site/MyBookingsFlow';
---

<Base 
  title="My Bookings | Grand Motors" 
  description="View your upcoming service requests and booking history with Grand Motors."
>
  <main class="pt-32 pb-20">
    <section class="px-6 md:px-12 lg:px-16">
      <SectionHeading
        eyebrow="My Account"
        intro="View your upcoming service requests and booking history."
        align="center"
      >
        <Fragment slot="title">My Bookings</Fragment>
      </SectionHeading>

      <Reveal delay={120} class="mt-14">
        <MyBookingsFlow client:load />
      </Reveal>
    </section>
  </main>
</Base>
