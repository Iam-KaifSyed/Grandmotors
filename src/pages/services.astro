---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getAppEnv, getDatabase } from '../lib/env';
import { getPublicCatalogueOrDefault } from '../lib/serviceStore';
import { getMediaUrlForUsageLocation } from '../lib/mediaStore';
import { iconForService } from '../components/site/serviceIcons';
import {
  ArrowRightIcon,
  ShieldCheckIcon,
  UsersIcon,
  GaugeIcon,
  BadgeIcon,
  EyeIcon,
  SearchIcon,
  WrenchIcon,
  CheckIcon,
  TruckIcon,
  PhoneIcon,
  ClockIcon,
} from '../components/site/Icons';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';

const env = getAppEnv(Astro.locals);
const db = getDatabase(Astro.locals, env);

const services = await getPublicCatalogueOrDefault(db);
const HERO_IMAGE = await getMediaUrlForUsageLocation(db, 'services-hero', '/images/services-hero.jpg');
const CTA_IMAGE = await getMediaUrlForUsageLocation(
  db,
  'services-cta',
  'https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=2000&q=80'
);

const STATS = [
  { value: '15+', label: 'Years in the workshop' },
  { value: '20k+', label: 'Vehicles serviced' },
  { value: '8', label: 'Specialist service bays' },
  { value: '4.9★', label: 'Average customer rating' },
];

const PROCESS_STEPS = [
  {
    n: '01',
    icon: EyeIcon,
    title: 'Inspect',
    body: 'A thorough multi-point check to understand the full condition of your vehicle before any work begins.',
  },
  {
    n: '02',
    icon: SearchIcon,
    title: 'Diagnose',
    body: 'Computerised scanning and expert assessment isolate the root cause, not just the symptom.',
  },
  {
    n: '03',
    icon: WrenchIcon,
    title: 'Repair',
    body: 'Skilled technicians carry out the work to specification using genuine-quality parts.',
  },
  {
    n: '04',
    icon: CheckIcon,
    title: 'Test',
    body: 'Every repair is verified and road-tested so the fix is confirmed before it reaches you.',
  },
  {
    n: '05',
    icon: TruckIcon,
    title: 'Deliver',
    body: 'Your car is returned clean, documented and ready, with a clear summary of the work done.',
  },
];

const PROMISES = [
  {
    icon: ShieldCheckIcon,
    title: 'Genuine-quality parts',
    body: 'OEM and premium-grade components only, with a clear warranty on parts and labour.',
  },
  {
    icon: GaugeIcon,
    title: 'Factory-level diagnostics',
    body: 'Dealer-grade scanning tools read every module so nothing is missed or guessed.',
  },
  {
    icon: UsersIcon,
    title: 'Certified technicians',
    body: 'Brand-trained specialists who treat performance and luxury vehicles with real care.',
  },
  {
    icon: BadgeIcon,
    title: 'Transparent pricing',
    body: 'A detailed quote before work starts. No surprise charges, no unnecessary jobs.',
  },
];
---

<Base
  title="Services | Grand Motors"
  description="Explore the full range of automotive services at Grand Motors, Moosapet, Hyderabad — from engine diagnostics and brakes to body, paint and detailing."
>
  <main class="pb-20">
    <!-- ============================================================ -->
    <!-- HERO                                                         -->
    <!-- ============================================================ -->
    <section class="relative isolate overflow-hidden">
      <!-- Background image -->
      <div aria-hidden="true" class="absolute inset-0 -z-10">
        <img
          src={HERO_IMAGE}
          alt=""
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-[var(--gm-bg-page)]/85"></div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-[var(--gm-bg-page)] via-[var(--gm-bg-page)]/60 to-[var(--gm-bg-page)]/30"
        ></div>
      </div>

      <div class="px-4 sm:px-8 md:px-12 lg:px-16 pt-32 pb-16 md:pt-44 md:pb-28">
        <div class="max-w-7xl mx-auto">
          <Reveal class="flex items-center gap-2.5 mb-5 sm:mb-6">
            <span class="w-5 sm:w-6 h-px bg-[var(--gm-accent-primary)]"></span>
            <span class="text-[10px] sm:text-[11px] font-semibold tracking-[0.25em] sm:tracking-[0.3em] text-[var(--gm-accent-primary)] uppercase">
              What We Do
            </span>
          </Reveal>
          <Reveal
            as="h1"
            delay={80}
            class="max-w-3xl text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-[-0.035em] text-[var(--gm-text-primary)] leading-[1.0] sm:leading-[0.98] uppercase"
          >
            Services, Engineered<br class="hidden sm:block" /> Around Your Car
          </Reveal>
          <Reveal
            as="p"
            delay={160}
            class="mt-4 sm:mt-6 max-w-xl text-xs sm:text-sm md:text-base leading-relaxed text-[var(--gm-text-secondary)]"
          >
            A complete workshop under one roof. From diagnostics to detailing, every service is
            delivered with the same precision you expect from a premium garage.
          </Reveal>

          <Reveal delay={240} class="mt-8 sm:mt-9 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-3.5">
            <a
              href="/book-service"
              class="group inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-full bg-[var(--gm-accent-primary)] text-[var(--gm-accent-foreground)] font-semibold tracking-[0.02em] transition-colors duration-200 hover:bg-[var(--gm-accent-hover)] cursor-pointer text-center shadow-lg shadow-[var(--gm-accent-primary)]/20"
            >
              Book a Service
              <ArrowRightIcon className="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </a>
            <a
              href="#catalogue"
              class="group inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-full border border-[var(--gm-border-medium)] text-[var(--gm-text-primary)] font-semibold tracking-[0.02em] transition-colors duration-200 hover:border-[var(--gm-accent-border)] hover:bg-[var(--gm-accent-muted)] cursor-pointer text-center shadow-sm"
            >
              Browse Services
            </a>
          </Reveal>
        </div>
      </div>

      <!-- Stats band -->
      <div class="relative border-t border-[var(--gm-border-subtle)] bg-[var(--gm-bg-surface)]/90 backdrop-blur-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
          <dl class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-0 lg:divide-x divide-[var(--gm-border-subtle)] py-4 lg:py-0">
            {STATS.map((s, i) => (
              <Reveal
                delay={i * 80}
                class="py-4 sm:py-6 lg:py-7 px-3 sm:px-4 lg:first:pl-0 text-center lg:text-left bg-[var(--gm-bg-card-subtle)] lg:bg-transparent rounded-xl lg:rounded-none border border-[var(--gm-border-subtle)] lg:border-none"
              >
                <dt class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-[-0.02em] text-[var(--gm-text-primary)]">
                  {s.value}
                </dt>
                <dd class="mt-1 text-[11px] sm:text-[12px] md:text-[13px] tracking-[0.06em] sm:tracking-[0.08em] uppercase text-[var(--gm-text-secondary)]">
                  {s.label}
                </dd>
              </Reveal>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SERVICE CATALOGUE (image cards)                              -->
    <!-- ============================================================ -->
    <section id="catalogue" class="scroll-mt-28 px-6 md:px-12 lg:px-16 pt-20 md:pt-28">
      <div class="max-w-7xl mx-auto">
        <SectionHeading
          eyebrow="The Catalogue"
          intro="Specialist areas handled by technicians who do that work every day. Tap any service to book it directly."
        >
          <Fragment slot="title">Everything Your Car Needs</Fragment>
        </SectionHeading>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service, i) => {
            const Icon = iconForService(service.id);
            return (
              <Reveal
                delay={(i % 3) * 70}
                as="article"
                class="group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--gm-border-subtle)] bg-[var(--gm-bg-card)] transition-all duration-200 hover:border-[var(--gm-accent-border)] hover:bg-[var(--gm-bg-card-hover)] shadow-sm"
              >
                {/* Image */}
                <div class="relative aspect-[16/10] overflow-hidden">
                  <img
                    src={service.imageUrl}
                    alt={service.imageAlt}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 bg-gradient-to-t from-[var(--gm-bg-card)] via-[var(--gm-bg-card)]/35 to-transparent"
                  ></div>
                  <span class="absolute left-4 top-4 grid place-items-center w-11 h-11 rounded-xl border border-[var(--gm-border-medium)] bg-[var(--gm-bg-surface)]/80 text-[var(--gm-accent-primary)] backdrop-blur-sm shadow-sm">
                    <Icon className="w-5 h-5" />
                  </span>
                </div>

                {/* Body */}
                <div class="flex flex-1 flex-col p-6 md:p-7">
                  <h3 class="text-lg font-semibold tracking-[-0.01em] text-[var(--gm-text-primary)]">
                    {service.title}
                  </h3>
                  <p class="mt-1.5 text-[13.5px] leading-relaxed text-[var(--gm-text-secondary)]">
                    {service.summary}
                  </p>

                  <ul class="mt-5 grid gap-2.5 border-t border-[var(--gm-border-subtle)] pt-5">
                    {service.items.map((item) => (
                      <li class="flex items-start gap-2.5 text-[13px] text-[var(--gm-text-secondary)]">
                        <CheckIcon className="w-4 h-4 mt-0.5 shrink-0 text-[var(--gm-accent-primary)]" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>

                  <a
                    href={`/book-service?service=${encodeURIComponent(service.id)}`}
                    class="mt-6 inline-flex items-center gap-2 self-start text-[13px] font-semibold tracking-[0.02em] text-[var(--gm-accent-primary)] transition-colors duration-200 hover:text-[var(--gm-accent-hover)] cursor-pointer"
                  >
                    Book this service
                    <ArrowRightIcon className="w-4 h-4 transition-transform group-hover:translate-x-1" />
                  </a>
                </div>
              </Reveal>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- OUR PROCESS                                                  -->
    <!-- ============================================================ -->
    <section class="mt-20 md:mt-24 px-4 sm:px-8 md:px-12 lg:px-16 py-16 md:py-28 bg-[var(--gm-bg-surface)] border-y border-[var(--gm-border-subtle)] transition-colors duration-200">
      <div class="max-w-7xl mx-auto">
        <SectionHeading
          eyebrow="Our Process"
          intro="A disciplined workflow that keeps your car — and you — informed from drop-off to delivery."
        >
          <Fragment slot="title">Five Steps, Zero Guesswork</Fragment>
        </SectionHeading>

        <div class="mt-12 sm:mt-16 relative">
          <div
            aria-hidden="true"
            class="hidden lg:block absolute top-6 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--gm-accent-primary)]/30 to-transparent"
          ></div>
          <ol class="grid gap-8 sm:gap-10 grid-cols-1 sm:grid-cols-2 lg:grid-cols-5">
            {PROCESS_STEPS.map((step, i) => {
              const Icon = step.icon;
              return (
                <Reveal delay={i * 90} as="li" class={`relative ${i === 4 ? 'sm:col-span-2 lg:col-span-1' : ''}`}>
                  <div class="flex items-center gap-3 lg:flex-col lg:items-start">
                    <span class="relative z-10 grid place-items-center w-11 h-11 sm:w-12 sm:h-12 rounded-full border border-[var(--gm-accent-border)] bg-[var(--gm-bg-card)] text-[var(--gm-accent-primary)] shrink-0 shadow-sm">
                      <Icon className="w-5 h-5" />
                    </span>
                    <span class="font-mono text-[11px] tracking-[0.3em] text-[var(--gm-text-secondary)]/70">
                      {step.n}
                    </span>
                  </div>
                  <h3 class="mt-3 sm:mt-5 text-base sm:text-lg font-semibold tracking-[-0.01em] text-[var(--gm-text-primary)]">
                    {step.title}
                  </h3>
                  <p class="mt-1.5 sm:mt-2 text-xs sm:text-[13.5px] leading-relaxed text-[var(--gm-text-secondary)]">{step.body}</p>
                </Reveal>
              );
            })}
          </ol>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- WHY GRAND MOTORS                                             -->
    <!-- ============================================================ -->
    <section class="px-4 sm:px-8 md:px-12 lg:px-16 pt-16 md:pt-28">
      <div class="max-w-7xl mx-auto">
        <SectionHeading
          eyebrow="The Promise"
          intro="Premium service is as much about trust as it is about tools. Here is what every job comes with."
        >
          <Fragment slot="title">Why Owners Choose Us</Fragment>
        </SectionHeading>

        <div class="mt-10 sm:mt-14 grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          {PROMISES.map((p, i) => {
            const Icon = p.icon;
            return (
              <Reveal
                delay={(i % 4) * 70}
                class="group rounded-2xl border border-[var(--gm-border-subtle)] bg-[var(--gm-bg-card)] p-6 sm:p-7 transition-all duration-200 hover:border-[var(--gm-accent-border)] hover:bg-[var(--gm-bg-card-hover)] shadow-sm"
              >
                <span class="grid place-items-center w-11 h-11 sm:w-12 sm:h-12 rounded-xl border border-[var(--gm-border-subtle)] text-[var(--gm-accent-primary)] transition-colors duration-200 group-hover:border-[var(--gm-accent-border)] group-hover:bg-[var(--gm-accent-muted)] shadow-sm">
                  <Icon className="w-5 h-5 sm:w-6 sm:h-6" />
                </span>
                <h3 class="mt-4 sm:mt-5 text-base font-semibold tracking-[-0.01em] text-[var(--gm-text-primary)]">
                  {p.title}
                </h3>
                <p class="mt-2 text-xs sm:text-[13.5px] leading-relaxed text-[var(--gm-text-secondary)]">{p.body}</p>
              </Reveal>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CTA BANNER (image)                                           -->
    <!-- ============================================================ -->
    <section class="px-4 sm:px-8 md:px-12 lg:px-16 pt-16 md:pt-28">
      <div class="max-w-7xl mx-auto">
        <Reveal class="relative isolate overflow-hidden rounded-2xl sm:rounded-3xl border border-[var(--gm-border-subtle)] shadow-xl">
          <div aria-hidden="true" class="absolute inset-0 -z-10">
            <img
              src={CTA_IMAGE}
              alt=""
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center"
            />
            <div class="absolute inset-0 bg-[var(--gm-bg-page)]/85 sm:bg-[var(--gm-bg-page)]/80"></div>
            <div
              class="absolute inset-0 bg-gradient-to-r from-[var(--gm-bg-page)] via-[var(--gm-bg-page)]/80 to-transparent"
            ></div>
          </div>

          <div class="px-6 py-10 sm:px-10 sm:py-14 md:px-14 md:py-20">
            <h2 class="max-w-xl text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-[-0.03em] text-[var(--gm-text-primary)] leading-[1.05] uppercase">
              Ready when<br /> your car is
            </h2>
            <p class="mt-4 sm:mt-5 max-w-md text-xs sm:text-sm md:text-[15px] leading-relaxed text-[var(--gm-text-secondary)]">
              Book online in under a minute, or call the workshop and speak to a technician directly.
              Doorstep service & pickup within Hyderabad available on request.
            </p>

            <div class="mt-7 sm:mt-9 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-3.5">
              <a
                href="/book-service"
                class="group inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-full bg-[var(--gm-accent-primary)] text-[var(--gm-accent-foreground)] font-semibold tracking-[0.02em] transition-colors duration-200 hover:bg-[var(--gm-accent-hover)] cursor-pointer text-center shadow-lg shadow-[var(--gm-accent-primary)]/20"
              >
                Book a Service
                <ArrowRightIcon className="w-4 h-4 transition-transform group-hover:translate-x-1" />
              </a>
              <a
                href="tel:+918623948898"
                class="group inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-full border border-[var(--gm-border-medium)] text-[var(--gm-text-primary)] font-semibold tracking-[0.02em] transition-colors duration-200 hover:border-[var(--gm-accent-border)] hover:bg-[var(--gm-accent-muted)] cursor-pointer text-center shadow-sm"
              >
                <PhoneIcon className="w-4 h-4 text-[var(--gm-accent-primary)]" />
                Call the Workshop
              </a>
            </div>

            <p class="mt-6 sm:mt-7 inline-flex items-center gap-2 text-[11px] sm:text-[12.5px] tracking-[0.06em] text-[var(--gm-text-secondary)]">
              <ClockIcon className="w-4 h-4 text-[var(--gm-accent-primary)]" />
              Open Mon–Sat, 9:00 AM – 8:00 PM
            </p>
          </div>
        </Reveal>
      </div>
    </section>
  </main>
</Base>
