---
import Base from '../layouts/Base.astro';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { PinIcon, PhoneIcon, ClockIcon } from '../components/site/Icons';

const PHONE_DISPLAY = '+91 86239 48898';
const PHONE_TEL = '+918623948898';
const MAPS_QUERY = encodeURIComponent(
  'Grand Motors, Metro Pillar No. 842, 5-7-73/NR, beside JSP Honda Showroom, Habeeb Nagar, Moosapet, Hyderabad, Telangana 500072'
);
const MAPS_LINK = `https://www.google.com/maps/search/?api=1&query=${MAPS_QUERY}`;
const MAPS_EMBED = `https://maps.google.com/maps?q=${MAPS_QUERY}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
const ADDRESS_LINE_1 = 'Metro Pillar No. 842, 5-7-73/NR';
const ADDRESS_LINE_2 = 'Beside JSP Honda Showroom, Habeeb Nagar';
const ADDRESS_LINE_3 = 'Moosapet, Hyderabad, Telangana 500072';
---

<Base 
  title="Contact | Grand Motors" 
  description="Get in touch with Grand Motors. Find our location in Moosapet, Hyderabad."
>
  <main class="pt-32 sm:pt-36 md:pt-40 pb-16 md:pb-24">
    <section class="max-w-7xl mx-auto px-4 sm:px-8 md:px-12 lg:px-16 grid gap-10 lg:grid-cols-2 lg:items-stretch">
      <div class="flex flex-col">
        <SectionHeading
          eyebrow="Visit Us"
          intro="Find us in Moosapet, Hyderabad. Call ahead or drop by — we are happy to walk you through what your car needs."
        >
          <Fragment slot="title">Location & Contact</Fragment>
        </SectionHeading>

        <Reveal delay={160} class="mt-8 sm:mt-10 flex flex-col gap-4 sm:gap-5">
          {[
            {
              icon: PinIcon,
              label: 'Workshop',
              lines: ['Grand Motors', ADDRESS_LINE_1, ADDRESS_LINE_2, ADDRESS_LINE_3],
              href: MAPS_LINK,
              external: true,
            },
            { icon: PhoneIcon, label: 'Phone', lines: [PHONE_DISPLAY], href: `tel:${PHONE_TEL}` },
            {
              icon: ClockIcon,
              label: 'Hours',
              lines: ['Open Mon–Sat, 9:00 AM – 8:00 PM (Emergency 24/7)'],
            },
          ].map((row) => {
            const Icon = row.icon;
            const content = (
              <>
                <span class="shrink-0 grid place-items-center w-10 h-10 sm:w-11 sm:h-11 rounded-lg border border-[var(--gm-border-subtle)] text-[var(--gm-accent-primary)] transition-colors duration-200 group-hover:border-[var(--gm-accent-border)] group-hover:bg-[var(--gm-accent-muted)] shadow-sm">
                  <Icon className="w-5 h-5" />
                </span>
                <div>
                  <span class="block text-[10px] sm:text-[11px] font-semibold tracking-[0.2em] sm:tracking-[0.22em] uppercase text-[var(--gm-text-secondary)]">
                    {row.label}
                  </span>
                  {row.lines.map((line) => (
                    <span class="block text-[13px] sm:text-[14px] md:text-[15px] text-[var(--gm-text-primary)] leading-snug mt-0.5">
                      {line}
                    </span>
                  ))}
                </div>
              </>
            );
            return row.href ? (
              <a
                href={row.href}
                target={row.external ? '_blank' : undefined}
                rel={row.external ? 'noopener noreferrer' : undefined}
                class="group flex items-start gap-3.5 sm:gap-4 p-3.5 sm:p-4 rounded-xl bg-[var(--gm-bg-card)] border border-[var(--gm-border-subtle)] hover:border-[var(--gm-accent-border)] hover:bg-[var(--gm-bg-card-hover)] transition-all cursor-pointer shadow-sm"
              >
                {content}
              </a>
            ) : (
              <div class="group flex items-start gap-3.5 sm:gap-4 p-3.5 sm:p-4 rounded-xl bg-[var(--gm-bg-card)] border border-[var(--gm-border-subtle)] shadow-sm">
                {content}
              </div>
            );
          })}
        </Reveal>
      </div>

      <Reveal delay={120} class="min-h-[300px] sm:min-h-[360px] lg:min-h-full mt-4 lg:mt-0">
        <div class="relative h-full min-h-[300px] sm:min-h-[360px] rounded-2xl overflow-hidden border border-[var(--gm-border-medium)] shadow-xl">
          <iframe
            title="Grand Motors location on Google Maps — Moosapet, Hyderabad"
            src={MAPS_EMBED}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 w-full h-full grayscale-[0.2] contrast-[1.05]"
            style="border: 0;"
            allowfullscreen
          ></iframe>
        </div>
      </Reveal>
    </section>
  </main>
</Base>
