---
import Base from '../layouts/Base.astro';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { TrackBookingFlow } from '../components/site/TrackBookingFlow';
---

<Base 
  title="Track Car Service Booking | Grand Motors Hyderabad" 
  description="Track live progress and repair status of your car mechanic service with Grand Motors. Real-time updates from inspection to road-testing and delivery."
  keywords="track car booking, car service status Hyderabad, Grand Motors tracking"
>
  <main class="pt-32 sm:pt-36 md:pt-40 pb-16 md:pb-24">
    <section class="max-w-4xl mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
      <SectionHeading
        eyebrow="Service Status"
        intro="Enter your Booking ID to view the live progress and schedule details of your vehicle service."
        align="center"
      >
        <Fragment slot="title">Track Your Booking</Fragment>
      </SectionHeading>

      <Reveal delay={120} class="mt-10 sm:mt-14">
        <TrackBookingFlow client:load />
      </Reveal>
    </section>
  </main>
</Base>
