---
export const prerender = false;

import Base from '../layouts/Base.astro';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { BookServiceForm } from '../components/site/BookServiceForm';
import { getAppEnv, getDatabase } from '../lib/env';
import { getBookingOptionsOrDefault } from '../lib/serviceStore';
import { getBookingFormConfigOrDefault } from '../lib/bookingFormConfigStore';

const env = getAppEnv(Astro.locals);
const db = getDatabase(Astro.locals, env);

const bookingOptions = await getBookingOptionsOrDefault(db);
const bookingConfig = await getBookingFormConfigOrDefault(db);
---

<Base 
  title="Book Car Mechanic Online Hyderabad | Doorstep & Workshop Service | Grand Motors" 
  description="Book a car mechanic online in Hyderabad in 60 seconds with Grand Motors. Doorstep car mechanic near me, jump start, brake repair, oil change & upfront transparent prices."
  keywords="car mechanic book online, online car mechanic near me, online car mechanic, doorstep car mechanic near me, mobile car mechanic near me, cheap car repair Hyderabad"
>
  <main class="pt-32 sm:pt-36 md:pt-40 pb-16 md:pb-24">
    <section class="max-w-4xl mx-auto px-4 sm:px-8 md:px-12 lg:px-16">
      <SectionHeading
        eyebrow="Appointments"
        intro={bookingConfig.supportingText}
        align="center"
      >
        <Fragment slot="title">{bookingConfig.heading}</Fragment>
      </SectionHeading>

      <Reveal delay={120} class="mt-10 sm:mt-14">
        <BookServiceForm client:load services={bookingOptions} config={bookingConfig} />
      </Reveal>
    </section>
  </main>
</Base>
