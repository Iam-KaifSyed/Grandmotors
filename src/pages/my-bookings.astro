---
import Base from '../layouts/Base.astro';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { MyBookingsView } from '../components/site/MyBookingsView';
---

<Base 
  title="My Bookings | Grand Motors" 
  description="View and manage your recent service requests and appointments with Grand Motors."
>
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeading
        eyebrow="Customer Portal"
        intro="Your recent service requests"
        align="center"
      >
        <Fragment slot="title">My Bookings</Fragment>
      </SectionHeading>

      <Reveal delay={120} class="mt-14">
        <MyBookingsView client:load />
      </Reveal>
    </section>
  </main>
</Base>
