---
import Base from '../layouts/Base.astro';
import Reveal from '../components/site/Reveal.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { BookServiceForm } from '../components/site/BookServiceForm';
---

<Base 
  title="Book Service | Grand Motors" 
  description="Book your next service appointment with Grand Motors."
>
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeading
        eyebrow="Appointments"
        intro="Schedule your service. We'll contact you shortly to confirm the details and time."
        align="center"
      >
        <Fragment slot="title">Book Your Service</Fragment>
      </SectionHeading>

      <Reveal delay={120} class="mt-14">
        <BookServiceForm client:load />
      </Reveal>
    </section>
  </main>
</Base>
