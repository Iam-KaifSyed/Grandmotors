---
const pathname = new URL(Astro.request.url).pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/my-bookings', label: 'My Bookings' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 md:px-12 lg:px-16 py-3.5 sm:py-4 transition-all duration-300 pointer-events-none">
  <!-- Backdrop Gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#07090A]/90 via-[#07090A]/60 to-transparent pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 pointer-events-auto group shrink-0 py-1">
      <span class="text-xs sm:text-sm font-semibold tracking-[0.25em] text-[#F2F0EA] uppercase group-hover:text-[#B88952] transition-colors">
        Grand Motors
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#B88952] shadow-[0_0_8px_rgba(184,137,82,0.8)]"></span>
    </a>

    <!-- Desktop / Tablet Centered Nav Pill -->
    <nav class="hidden md:flex items-center bg-black/40 backdrop-blur-md border border-white/10 rounded-full px-2 py-1.5 pointer-events-auto shadow-lg shadow-black/40">
      {links.map(link => {
        const isActive = link.href === '/' ? pathname === '/' : pathname.startsWith(link.href);
        return (
          <a 
            href={link.href} 
            class={`px-3.5 lg:px-4 py-1.5 text-xs font-semibold tracking-[0.1em] uppercase whitespace-nowrap rounded-full transition-all duration-300 ${
              isActive 
                ? 'bg-[#B88952]/20 text-[#B88952] shadow-[inset_0_0_8px_rgba(184,137,82,0.2)]' 
                : 'text-[#A7AAAD] hover:text-[#F2F0EA] hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        )
      })}
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2.5 sm:gap-3 pointer-events-auto">
      <!-- Desktop "Book Service" Button -->
      <a
        href="/book-service"
        class="hidden sm:inline-flex items-center justify-center px-4 sm:px-5 py-2 text-xs font-semibold tracking-[0.14em] uppercase text-[#0A0C0D] bg-[#B88952] hover:bg-[#caa066] active:bg-[#a67943] rounded-full transition-all shadow-md shadow-[#B88952]/10"
      >
        Book Service
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        class="md:hidden flex items-center justify-center w-9 h-9 rounded-full bg-black/50 backdrop-blur-md border border-white/10 text-[#F2F0EA] hover:text-[#B88952] hover:border-[#B88952]/40 transition-all cursor-pointer"
      >
        <svg id="hamburger-icon" class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-4 h-4 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu Overlay -->
  <div
    id="mobile-nav-menu"
    class="md:hidden fixed inset-x-0 top-[60px] p-4 pointer-events-none transition-all duration-300 opacity-0 -translate-y-2 invisible"
  >
    <div class="bg-[#0e1013]/95 backdrop-blur-xl border border-white/12 rounded-2xl p-5 shadow-2xl space-y-4 max-w-sm mx-auto pointer-events-auto">
      <nav class="flex flex-col gap-1">
        {links.map(link => {
          const isActive = link.href === '/' ? pathname === '/' : pathname.startsWith(link.href);
          return (
            <a 
              href={link.href} 
              class={`flex items-center justify-between px-4 py-3 text-xs font-bold tracking-[0.14em] uppercase rounded-xl transition-all ${
                isActive 
                  ? 'bg-[#B88952]/15 text-[#B88952] border border-[#B88952]/30' 
                  : 'text-[#D8D6D0] hover:text-white hover:bg-white/5'
              }`}
            >
              <span>{link.label}</span>
              {isActive && <span class="w-1.5 h-1.5 rounded-full bg-[#B88952]"></span>}
            </a>
          )
        })}
      </nav>

      <div class="pt-3 border-t border-white/8 space-y-2.5">
        <a
          href="/book-service"
          class="flex items-center justify-center w-full px-5 py-3 text-xs font-bold tracking-[0.18em] uppercase text-[#0A0C0D] bg-[#B88952] hover:bg-[#caa066] active:bg-[#a67943] rounded-xl transition-colors shadow-lg shadow-[#B88952]/15 text-center"
        >
          Book Service
        </a>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <a
            href="tel:+918623948898"
            class="flex items-center justify-center gap-1.5 px-3 py-2.5 text-[11px] font-semibold tracking-wider uppercase text-[#F2F0EA] bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl transition-colors"
          >
            <span>Call</span>
          </a>
          <a
            href="https://wa.me/918623948898"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 px-3 py-2.5 text-[11px] font-semibold tracking-wider uppercase text-[#25D366] bg-[#25D366]/10 hover:bg-[#25D366]/20 border border-[#25D366]/20 rounded-xl transition-colors"
          >
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const menu = document.getElementById('mobile-nav-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggle || !menu || !hamburgerIcon || !closeIcon) return;

    let isOpen = false;

    const openMenu = () => {
      isOpen = true;
      toggle.setAttribute('aria-expanded', 'true');
      menu.classList.remove('opacity-0', '-translate-y-2', 'invisible', 'pointer-events-none');
      menu.classList.add('opacity-100', 'translate-y-0', 'visible', 'pointer-events-auto');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    };

    const closeMenu = () => {
      isOpen = false;
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.add('opacity-0', '-translate-y-2', 'invisible', 'pointer-events-none');
      menu.classList.remove('opacity-100', 'translate-y-0', 'visible', 'pointer-events-auto');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    };

    toggle.onclick = (e) => {
      e.stopPropagation();
      if (isOpen) closeMenu();
      else openMenu();
    };

    // Close on clicking outside
    document.addEventListener('click', (e) => {
      if (isOpen && !menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
        closeMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });
  }

  // Setup on page load and on Astro view transitions
  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
